
# =============================================
# Breast Cancer Gene Expression Classification
# =============================================

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.feature_selection import VarianceThreshold, SelectKBest, f_classif
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.model_selection import (
    RepeatedStratifiedKFold,
    cross_validate
)

# 1. Load dataset
url = "https://huggingface.co/datasets/mubashir1837/Breast-Cancer-Gen-Expression-Dataset/resolve/main/cleaned_expression.csv"

df = pd.read_csv(url)

# 2. Separate target and gene expression data
y = df["Response"]

X = df.drop(
    columns=["Response", "Unnamed: 0"],
    errors="ignore"
)

X = X.select_dtypes(include=["number"])

print("Samples:", X.shape[0])
print("Gene features:", X.shape[1])
print("Response distribution:")
print(y.value_counts())

# 3. Build complete machine learning pipeline
pipeline = Pipeline([
    ("imputer", SimpleImputer(strategy="median")),

    ("variance", VarianceThreshold(threshold=0.01)),

    ("anova", SelectKBest(score_func=f_classif, k=10)),

    ("scaler", StandardScaler()),

    ("logistic", LogisticRegression(
        max_iter=5000,
        solver="liblinear",
        penalty="l2",
        C=1.0
    ))
])

# 4. Stratified repeated cross-validation
cv = RepeatedStratifiedKFold(
    n_splits=5,
    n_repeats=10,
    random_state=42
)

results = cross_validate(
    pipeline,
    X,
    y,
    cv=cv,
    scoring={
        "accuracy": "accuracy",
        "roc_auc": "roc_auc",
        "balanced_accuracy": "balanced_accuracy"
    }
)

print("\nCROSS-VALIDATION RESULTS")

for metric in ["accuracy", "roc_auc", "balanced_accuracy"]:
    scores = results[f"test_{metric}"]

    print(
        f"{metric}: {scores.mean():.3f} "
        f"+/- {scores.std():.3f}"
    )

# 5. Fit final exploratory model on all samples
pipeline.fit(X, y)

# 6. Identify the selected genes
variance_mask = pipeline.named_steps[
    "variance"
].get_support()

remaining_genes = X.columns[variance_mask]

anova_mask = pipeline.named_steps[
    "anova"
].get_support()

selected_genes = remaining_genes[anova_mask]

# 7. Extract ANOVA F-scores
f_scores = pipeline.named_steps[
    "anova"
].scores_

gene_f_scores = pd.DataFrame({
    "Gene": remaining_genes,
    "ANOVA_F_Score": f_scores
})

gene_f_scores = gene_f_scores.sort_values(
    "ANOVA_F_Score",
    ascending=False
)

print("\nTOP 10 GENES BY ANOVA F-SCORE")
print(gene_f_scores.head(10).to_string(index=False))

# 8. Extract logistic regression coefficients
coefficients = pipeline.named_steps[
    "logistic"
].coef_[0]

gene_results = pd.DataFrame({
    "Gene": selected_genes,
    "Coefficient": coefficients
})

gene_results = gene_results.sort_values(
    "Coefficient",
    ascending=False
)

print("\nLOGISTIC REGRESSION COEFFICIENTS")
print(gene_results.to_string(index=False))

# 9. Plot logistic regression coefficients
plt.figure(figsize=(11, 6))

sns.barplot(
    data=gene_results,
    x="Gene",
    y="Coefficient"
)

plt.axhline(0, color="black", linewidth=0.8)
plt.xticks(rotation=45)
plt.title("Logistic Regression Coefficients for Selected Genes")
plt.ylabel("Standardized Coefficient")
plt.tight_layout()
plt.show()

# 10. Save results
gene_results.to_csv(
    "corrected_gene_coefficients.csv",
    index=False
)

gene_f_scores.to_csv(
    "gene_anova_scores.csv",
    index=False
)

# Additional Visualizations

sns.set_theme(style="whitegrid")

# 1. Response distribution
plt.figure(figsize=(7, 5))

sns.countplot(
    x=y,
    hue=y,
    palette="Set2",
    legend=False
)

plt.title("Distribution of Treatment Response")
plt.xlabel("Treatment Response")
plt.ylabel("Number of Patients")
plt.xticks([0, 1], ["Non-Responder", "Responder"])

plt.tight_layout()
plt.savefig("response_distribution.png", dpi=300)
plt.show()


# 2. Top 10 genes by ANOVA F-score
top10 = gene_f_scores.head(10).sort_values(
    "ANOVA_F_Score"
)

plt.figure(figsize=(9, 6))

sns.barplot(
    data=top10,
    x="ANOVA_F_Score",
    y="Gene"
)

plt.title("Top 10 Genes by ANOVA F-Score")
plt.xlabel("ANOVA F-Score")
plt.ylabel("Gene")

plt.tight_layout()
plt.savefig("anova_top10_genes.png", dpi=300)
plt.show()


# 3. Logistic regression coefficients
coef_plot = gene_results.sort_values("Coefficient")

plt.figure(figsize=(9, 6))

sns.barplot(
    data=coef_plot,
    x="Coefficient",
    y="Gene"
)

plt.axvline(0, color="black", linewidth=1)

plt.title("Logistic Regression Gene Coefficients")
plt.xlabel("Standardized Regression Coefficient")
plt.ylabel("Gene")

plt.tight_layout()
plt.savefig("logistic_coefficients.png", dpi=300)
plt.show()


# 4. Gene expression by treatment response
# Visualize top five genes by ANOVA score

top5_genes = gene_f_scores.head(5)["Gene"].tolist()

fig, axes = plt.subplots(2, 3, figsize=(14, 9))
axes = axes.flatten()

for i, gene in enumerate(top5_genes):

    plot_data = pd.DataFrame({
        "Expression": np.log2(X[gene] + 1),
        "Response": y.values
    })

    sns.boxplot(
        data=plot_data,
        x="Response",
        y="Expression",
        hue="Response",
        palette="Set2",
        legend=False,
        ax=axes[i]
    )

    axes[i].set_title(f"{gene} Expression")
    axes[i].set_xlabel("Response (0 = No, 1 = Yes)")
    axes[i].set_ylabel("Log2(Expression + 1)")

axes[-1].axis("off")

plt.suptitle(
    "Expression Distributions of Top 5 Genes",
    fontsize=15
)

plt.tight_layout()
plt.savefig("gene_expression_distributions.png", dpi=300)
plt.show()


# 5. Distribution of repeated CV scores
cv_plot = pd.DataFrame({
    "Accuracy": results["test_accuracy"],
    "ROC-AUC": results["test_roc_auc"]
})

plt.figure(figsize=(8, 5))

sns.boxplot(data=cv_plot)

plt.title("Repeated Stratified Cross-Validation Performance")
plt.ylabel("Score")
plt.ylim(0, 1)

plt.tight_layout()
plt.savefig("cross_validation_performance.png", dpi=300)
plt.show()
